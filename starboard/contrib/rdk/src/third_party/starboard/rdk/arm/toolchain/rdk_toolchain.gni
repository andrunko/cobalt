import("//build/toolchain/gcc_toolchain.gni")
import("//starboard/build/toolchain/cobalt_toolchains.gni")
import("//starboard/contrib/rdk/src/third_party/starboard/rdk/shared/build/rdk_toolchain.gni")

_rdk_toolchain_path = "$rdk_home_dir/sysroots/x86_64-rdksdk-linux/usr/bin/arm-rdkmllib32-linux-gnueabi"

rdk_source_dir = rebase_path("//starboard/contrib/rdk/src")

gcc_toolchain_ar = "ar"
gcc_toolchain_cc = "$_rdk_toolchain_path/arm-rdkmllib32-linux-gnueabi-gcc"
gcc_toolchain_cxx = "$_rdk_toolchain_path/arm-rdkmllib32-linux-gnueabi-g++"
gcc_toolchain_strip = "$_rdk_toolchain_path/arm-rdkmllib32-linux-gnueabi-strip"

template("rdk_gcc_toolchain") {
  gcc_toolchain(target_name) {
    cc  = gcc_toolchain_cc
    cxx = gcc_toolchain_cxx
    strip = gcc_toolchain_strip
    ld  = cxx
    ar  = gcc_toolchain_ar

    extra_cflags = "-I" + rdk_source_dir
    extra_cxxflags = "-I" + rdk_source_dir

    # extra_cflags   = ""
    # extra_cxxflags = ""
    # extra_ldflags  = extra_cxxflags
    # extra_asmflags = extra_cflags

    forward_variables_from(invoker, "*", [ "toolchain_args" ])
    toolchain_args = {
      if (defined(invoker.toolchain_args)) {
        forward_variables_from(invoker.toolchain_args, "*")
      }
      is_clang = false
    }
  }
}

template("rdk_clang_toolchain") {
  cobalt_clang_toolchain(target_name) {
    native_linker_path = gcc_toolchain_cxx

    extra_cflags = "-I" + rdk_source_dir
    extra_cxxflags = "-I" + rdk_source_dir

    forward_variables_from(invoker, "*", [ "toolchain_args" ])
    toolchain_args = {
      if (defined(invoker.toolchain_args)) {
        forward_variables_from(invoker.toolchain_args, "*")
      }
      is_clang = false
    }
  }
}

  include_dirs = [ "src/include", "//third_party/foo" ]

